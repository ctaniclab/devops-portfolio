<Window x:Class="MailArchive.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Mail Archive 1.1.0 — OST / PST" Width="1360" Height="900" MinWidth="1020" MinHeight="680" Background="#F3F6FA" Closing="Window_Closing">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Mail Archive" FontSize="28" FontWeight="SemiBold" Foreground="#182A43"/>
      <TextBlock Text="Просмотр OST и PST · Перенос писем в новый PST через Outlook" Margin="0,5,0,14" Foreground="#55657B"/>
      <WrapPanel>
        <Button x:Name="OpenButton" Content="Открыть OST / PST…" Click="Open_Click"/>
        <Button x:Name="ConvertButton" Content="OST → PST…" Click="Convert_Click" IsEnabled="False" Background="#225BBD" Foreground="White"/>
        <Button x:Name="ConvertSelectedButton" Content="Выбранное письмо → PST…" Click="ConvertSelected_Click" IsEnabled="False"/>
        <Button x:Name="CancelButton" Content="Остановить перенос" Click="Cancel_Click" IsEnabled="False"/>
        <Button x:Name="ReportButton" Content="Открыть отчёт / журнал…" Click="Report_Click" IsEnabled="False"/>
      </WrapPanel>
      <TextBlock x:Name="FileLabel" Text="Откройте файл, чтобы просмотреть папки и письма. Конвертация для просмотра не нужна." Margin="4,10" TextWrapping="Wrap"/>
      <Border Background="#E7EEF9" Padding="10" Margin="0,0,0,12"><TextBlock Text="Исходный файл открывается только для чтения. Работайте с локальной копией архива при закрытом Outlook. Просмотр не загружает внешние изображения и не запускает HTML." TextWrapping="Wrap" Foreground="#344D70"/></Border>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <ProgressBar x:Name="Progress" Height="4" Visibility="Collapsed"/>
      <TextBlock x:Name="Status" Text="Готово к открытию файла" Margin="2,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#D5DFEB" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="ПАПКИ" FontWeight="SemiBold" Foreground="#55657B" Margin="12"/>
          <TreeView x:Name="Folders" BorderThickness="0" SelectedItemChanged="Folder_Selected"/>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="280"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Background="White">
          <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="8" ToolTip="Поиск по теме, отправителю и получателю в выбранной папке" TextChanged="Search_Changed"/>
          <DataGrid x:Name="Messages" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" EnableRowVirtualization="True" SelectionChanged="Message_Selected" BorderBrush="#D5DFEB" GridLinesVisibility="Horizontal" Background="White">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Тема" Binding="{Binding Subject}" Width="*"/>
              <DataGridTextColumn Header="Отправитель" Binding="{Binding From}" Width="180"/>
              <DataGridTextColumn Header="Дата" Binding="{Binding DisplayDate}" Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
        <DockPanel Grid.Row="2" Background="White">
          <ScrollViewer DockPanel.Dock="Top" MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageHeader" Text="Выберите письмо" FontSize="15" FontWeight="SemiBold" Margin="12" TextWrapping="Wrap"/>
          </ScrollViewer>
          <DockPanel DockPanel.Dock="Bottom" Margin="8">
            <Button x:Name="SaveAttachmentButton" DockPanel.Dock="Right" Content="Сохранить вложение…" Click="SaveAttachment_Click" IsEnabled="False"/>
            <ComboBox x:Name="Attachments" DisplayMemberPath="Description" VerticalAlignment="Center" MinWidth="160" SelectionChanged="Attachment_Selected" ToolTip="Вложения выбранного письма"/>
          </DockPanel>
          <TabControl x:Name="BodyTabs" BorderBrush="#D5DFEB">
            <TabItem Header="Письмо">
              <Grid>
                <wv:WebView2 x:Name="HtmlPreview" Visibility="Collapsed"/>
                <TextBlock x:Name="PreviewHint" Text="Выберите письмо для подробного просмотра." Margin="16" TextWrapping="Wrap" VerticalAlignment="Top"/>
              </Grid>
            </TabItem>
            <TabItem Header="Текст письма"><TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="12"/></TabItem>
            <TabItem Header="Исходный HTML"><TextBox x:Name="HtmlText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="12"/></TabItem>
            <TabItem Header="Свойства">
              <DataGrid x:Name="MessageProperties" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Код" Binding="{Binding DisplayId}" Width="85"/>
                  <DataGridTextColumn Header="Свойство" Binding="{Binding Description}" Width="220"/>
                  <DataGridTextColumn Header="Значение" Binding="{Binding DisplayValue}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
