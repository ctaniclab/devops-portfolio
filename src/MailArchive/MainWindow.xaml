<Window x:Class="MailArchive.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Mail Archive 1.2.1 — OST / PST" Icon="Assets/archive-hero.png" Width="1380" Height="940" MinWidth="1050" MinHeight="760" Background="#F4F5FA" Closing="Window_Closing" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}">
  <DockPanel Margin="24,18,24,20">
    <StackPanel DockPanel.Dock="Top">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Mail Archive" FontSize="32" FontWeight="SemiBold" Foreground="#27334D"/>
            <Border Background="#E8ECFD" CornerRadius="7" Padding="8,4" Margin="12,9,0,5" VerticalAlignment="Center"><TextBlock Text="OST / PST" FontSize="11" FontWeight="SemiBold" Foreground="#5965B9"/></Border>
          </StackPanel>
          <TextBlock Text="Ваша почта — в порядке. Просматривайте архивы и переносите письма в Outlook." Margin="0,6,0,0" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
        </StackPanel>
        <Image Grid.Column="1" x:Name="HeaderArt" Source="Assets/archive-hero.png" Height="108" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>
      <WrapPanel>
        <Button x:Name="OpenButton" Content="Открыть OST / PST…" Click="Open_Click" Background="{StaticResource Accent}" Foreground="White"/>
        <Button x:Name="ConvertButton" Content="Весь OST → PST…" Click="Convert_Click" IsEnabled="False"/>
        <Button x:Name="ConvertSelectedButton" Content="Выбранное письмо → PST…" Click="ConvertSelected_Click" IsEnabled="False"/>
        <Button x:Name="CancelButton" Content="Остановить перенос" Click="Cancel_Click" IsEnabled="False" Background="#F7EDEA" Foreground="#A26855"/>
      </WrapPanel>
      <TextBlock x:Name="FileLabel" Text="Откройте архив — для просмотра конвертация не нужна." Margin="2,2,0,10" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
      <Border Background="#EAF4F3" CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
        <TextBlock Text="Только чтение · Используйте локальную копию архива при закрытом Outlook. Внешние картинки и скрипты писем отключены." TextWrapping="Wrap" Foreground="#47766E" FontSize="12"/>
      </Border>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,14,0,0">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button x:Name="OpenOutlookButton" Content="Открыть PST в Outlook…" Click="OpenOutlook_Click" Margin="0,0,8,0" ToolTip="Показывает сразу папку с письмами в классическом Outlook"/>
          <Button x:Name="ReportButton" Content="Отчёт / журнал…" Click="Report_Click" IsEnabled="False" Margin="0"/>
        </WrapPanel>
        <StackPanel VerticalAlignment="Center">
          <ProgressBar x:Name="Progress" Height="3" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="#EAEFFA"/>
          <TextBlock x:Name="Status" Text="Готово к открытию архива" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" FontSize="12"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="10,8,10,12">
            <TextBlock Text="Ваши папки" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="Выберите папку с письмами" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
          <TreeView x:Name="Folders" BorderThickness="0" Background="Transparent" SelectedItemChanged="Folder_Selected"/>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="0.8*" MinHeight="130"/><RowDefinition Height="12"/><RowDefinition Height="1.2*" MinHeight="180"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
              <TextBlock Text="Письма" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,18,0"/>
              <TextBox x:Name="Search" ToolTip="Поиск по теме, отправителю и получателю в выбранной папке" TextChanged="Search_Changed" AutomationProperties.Name="Поиск писем"/>
            </DockPanel>
            <DataGrid x:Name="Messages" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" EnableRowVirtualization="True" SelectionChanged="Message_Selected">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Тема" Binding="{Binding Subject}" Width="*"/>
                <DataGridTextColumn Header="Отправитель" Binding="{Binding From}" Width="180"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding DisplayDate}" Width="140"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
        <GridSplitter Grid.Row="1" Height="12" HorizontalAlignment="Stretch" Background="Transparent"/>
        <Border x:Name="MessagePane" Grid.Row="2" Style="{StaticResource Card}" Padding="10">
          <DockPanel>
            <ScrollViewer DockPanel.Dock="Top" MaxHeight="140" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="MessageHeader" Text="Выберите письмо" FontSize="14" FontWeight="SemiBold" Margin="8,6,8,12" TextWrapping="Wrap"/>
            </ScrollViewer>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <Button x:Name="SaveAttachmentButton" DockPanel.Dock="Right" Content="Сохранить вложение…" Click="SaveAttachment_Click" IsEnabled="False" Margin="8,0,0,0"/>
              <ComboBox x:Name="Attachments" DisplayMemberPath="Description" VerticalAlignment="Center" MinHeight="32" MinWidth="160" SelectionChanged="Attachment_Selected" ToolTip="Вложения выбранного письма"/>
            </DockPanel>
            <TabControl x:Name="BodyTabs" BorderThickness="0" Background="White">
              <TabItem Header="Письмо">
                <Grid>
                  <wv:WebView2 x:Name="HtmlPreview" Visibility="Collapsed"/>
                  <TextBlock x:Name="PreviewHint" Text="Здесь появится содержимое выбранного письма." Margin="16" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
              </TabItem>
              <TabItem Header="Текст письма"><TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="12" Background="White"/></TabItem>
              <TabItem Header="Исходный HTML"><TextBox x:Name="HtmlText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="12" Background="White"/></TabItem>
              <TabItem Header="Свойства">
                <DataGrid x:Name="MessageProperties" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Код" Binding="{Binding DisplayId}" Width="85"/>
                    <DataGridTextColumn Header="Свойство" Binding="{Binding Description}" Width="220"/>
                    <DataGridTextColumn Header="Значение" Binding="{Binding DisplayValue}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
            </TabControl>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
