<Window x:Class="MailArchive.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mail Archive 1.5.0 — OST / PST" Icon="Assets/app-icon.ico" Width="1320" Height="860" MinWidth="1000" MinHeight="680" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource UiFont}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" Closing="Window_Closing">
  <DockPanel Margin="22,16,22,18">
    <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderFill}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource HeaderPadding}" Margin="0,0,0,14"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Mail Archive" FontFamily="{DynamicResource TitleFont}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Читайте архивы или сохраняйте выбранные письма в PST и MSG" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
        <DockPanel><Button DockPanel.Dock="Right" Content="ℹ" Width="30" Height="30" Padding="0" Margin="8,0,0,0" Click="About_Click" ToolTip="О программе и лицензиях" AutomationProperties.Name="О программе и лицензиях"/><TextBlock Text="Тема" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="ThemeChoice" MinWidth="160" SelectionChanged="Theme_Changed" AutomationProperties.Name="Тема интерфейса" ToolTip="Выберите оформление. Liquid Glass и Прозрачная используют размытие Windows 11; если оно недоступно, применяется непрозрачный фон."/></DockPanel>
        <CheckBox x:Name="CompatibleRendering" Content="Совместимость с HDR" Margin="0,8,0,0" Checked="Compatibility_Changed" Unchecked="Compatibility_Changed" ToolTip="Программная отрисовка интерфейса и sRGB для письма. Настройки HDR Windows не меняются."/>
        <CheckBox x:Name="GlassEffects" Content="Эффекты стекла" Margin="0,5,0,0" Checked="GlassEffects_Changed" Unchecked="GlassEffects_Changed" Visibility="Collapsed" ToolTip="Системное размытие и прозрачность окна на Windows 11. Можно отключить, сохранив стиль темы."/>
        <TextBlock x:Name="ThemeHint" FontSize="10" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0" MaxWidth="270" TextWrapping="Wrap"/>
      </StackPanel>
      <Image x:Name="HeaderArt" Grid.Column="2" Source="Assets/archive-hero.png" Height="76" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid></Border>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,9" Margin="0,12,0,0">
      <DockPanel><Button x:Name="ReportButton" DockPanel.Dock="Right" Content="Отчёт / журнал…" Click="Report_Click" IsEnabled="False" Margin="10,0,0,0"/>
        <StackPanel VerticalAlignment="Center"><Grid x:Name="ProgressRow" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}"/><TextBlock x:Name="ConversionTiming" Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource Ink}" FontSize="12" TextWrapping="Wrap" MaxWidth="340"/></Grid><TextBlock x:Name="Status" Text="Выберите действие: просмотр архива или конвертация в PST." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource MutedInk}" FontSize="12"/></StackPanel>
      </DockPanel>
    </Border>
    <TabControl x:Name="ModeTabs" BorderThickness="0" Background="Transparent">
      <TabItem x:Name="ViewTab" Header="1. Просмотр архива">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderFill}" CornerRadius="{DynamicResource ButtonRadius}" Padding="{DynamicResource HeaderPadding}" Margin="0,2,0,12"><StackPanel>
            <WrapPanel><Button x:Name="OpenButton" Content="Открыть OST / PST…" Click="Open_Click" Background="{DynamicResource Accent}" Foreground="White"/><Button x:Name="ReadMessageButton" Content="Читать письмо" Click="ReadMessage_Click" IsEnabled="False"/><Button x:Name="ExportButton" Content="Конвертировать…" Click="Convert_Click"/><TextBlock Text="двойной щелчок — читать" VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}" FontSize="12"/></WrapPanel>
            <TextBlock x:Name="FileLabel" Text="Файл не выбран. Просмотр ничего не конвертирует." Margin="2,10,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedInk}" FontSize="12"/>
          </StackPanel></Border>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="190" MaxWidth="420"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="400"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10"><DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="4,3,4,10"><TextBlock Text="Папки с почтой" FontWeight="SemiBold" FontSize="16"/><CheckBox x:Name="ShowServiceFolders" Content="Показать служебные" Margin="0,10,0,0" FontSize="12" Checked="ShowService_Changed" Unchecked="ShowService_Changed"/></StackPanel>
              <TreeView x:Name="Folders" SelectedItemChanged="Folder_Selected"/>
            </DockPanel></Border>
            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" ToolTip="Изменить ширину папок"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border Background="Transparent"><Border x:Name="Grip" Width="4" Height="56" CornerRadius="2" Background="{DynamicResource ScrollThumb}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template></GridSplitter>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8"><DockPanel>
              <Grid DockPanel.Dock="Top" Margin="4,2,4,10"><TextBox x:Name="Search" TextChanged="Search_Changed" AutomationProperties.Name="Поиск в выбранной папке"/>
                <TextBlock Text="Поиск по теме, отправителю или получателю…" Margin="12,9,10,9" Foreground="{DynamicResource MutedInk}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </Grid>
              <TextBlock x:Name="FolderCaption" DockPanel.Dock="Top" Text="Выберите папку слева" Margin="8,0,8,10" Foreground="{DynamicResource MutedInk}" FontSize="12" TextWrapping="Wrap"/>
              <DataGrid x:Name="Messages" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" EnableRowVirtualization="True" SelectionChanged="Message_Selected" MouseDoubleClick="Messages_DoubleClick" PreviewKeyDown="Messages_KeyDown">
                <DataGrid.Columns><DataGridTextColumn Header="Тема" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="Отправитель" Binding="{Binding From}" Width="190"/><DataGridTextColumn Header="Дата" Binding="{Binding DisplayDate}" Width="150"/></DataGrid.Columns>
              </DataGrid>
            </DockPanel></Border>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="ConvertTab" Header="2. Конвертация">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,2,4,0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,12"><DockPanel><Button x:Name="ChooseOstButton" DockPanel.Dock="Right" Content="Выбрать OST / PST…" Click="ChooseOst_Click" Margin="16,0,0,0"/><StackPanel><TextBlock Text="1. Выберите копию OST или PST" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ConversionSource" Text="Файл не выбран" Margin="0,8,0,0" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap"/><TextBlock Text="Для конвертации нужен классический Outlook с настроенным профилем." FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
            <TextBlock Text="2. Выберите письма и формат" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Сначала отметьте нужные сообщения или выберите все. Затем выберите PST или MSG. Пустые папки не создаются." Foreground="{DynamicResource MutedInk}" Margin="0,8,0,12" TextWrapping="Wrap"/>
            <WrapPanel><Button x:Name="ConvertButton" Content="Конвертировать…" Click="Convert_Click" Background="{DynamicResource Accent}" Foreground="White"/><Button x:Name="CancelButton" Content="Остановить" Click="Cancel_Click" IsEnabled="False"/></WrapPanel>
            <Expander Header="Дополнительные параметры" Margin="0,12,0,0"><CheckBox x:Name="IncludeServiceFolders" Content="Включить служебные папки и журналы синхронизации" Margin="4,10,0,4"/></Expander>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="3. Откройте результат" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Мастер импорта не нужен: файл откроется отдельным архивом сразу на папке с письмами. Почтовый ящик не меняется." Foreground="{DynamicResource MutedInk}" Margin="0,8,0,12" TextWrapping="Wrap"/>
            <Button x:Name="OpenResultFolderButton" Content="Открыть папку MSG…" Click="OpenResultFolder_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,8"/>
            <Button x:Name="OpenOutlookButton" Content="Открыть PST в Outlook…" Click="OpenOutlook_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="ResultSummary" Text="Можно выбрать и ранее созданный PST." Foreground="{DynamicResource MutedInk}" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
