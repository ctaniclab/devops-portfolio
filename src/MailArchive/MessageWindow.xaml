<Window x:Class="MailArchive.MessageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Чтение письма — Mail Archive" Icon="Assets/archive-hero.png" Width="1100" Height="820" MinWidth="820" MinHeight="640" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource UiFont}" FontSize="14" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" WindowStartupLocation="CenterOwner" Closing="Reader_Closing">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
      <TextBlock x:Name="SubjectText" Text="Загрузка письма…" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="SenderText" Foreground="{DynamicResource MutedInk}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      <Expander Header="Получатели и даты" Margin="0,8,0,0"><ScrollViewer MaxHeight="85" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="HeaderDetails" TextWrapping="Wrap" Margin="4,8" Foreground="{DynamicResource MutedInk}"/></ScrollViewer></Expander>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
      <DockPanel><Button x:Name="SaveAttachmentButton" DockPanel.Dock="Right" Content="Сохранить вложение…" Click="SaveAttachment_Click" IsEnabled="False" Margin="10,0,0,0"/><ComboBox x:Name="Attachments" DisplayMemberPath="Description" SelectionChanged="Attachment_Selected" ToolTip="Файловые вложения"/></DockPanel>
      <DockPanel Margin="0,10,0,0"><WrapPanel DockPanel.Dock="Right"><Button x:Name="ExportMessageButton" Content="Конвертировать это письмо…" Click="Export_Click" IsEnabled="False"/><Button Content="Закрыть" Click="Close_Click" Margin="0"/></WrapPanel><TextBlock x:Name="ReaderStatus" Text="Чтение содержимого…" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"/></DockPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="10"><DockPanel>
      <CheckBox x:Name="OriginalColors" DockPanel.Dock="Top" Content="Светлый фон письма" Checked="Colors_Changed" Unchecked="Colors_Changed" Margin="4,0,4,8" FontSize="12"/>
      <TabControl x:Name="BodyTabs" BorderThickness="0" Background="{DynamicResource Surface}">
        <TabItem Header="Письмо"><Grid><wv:WebView2 x:Name="HtmlPreview" Visibility="Collapsed"/><TextBlock x:Name="PreviewHint" Text="Загрузка письма…" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="14" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></TabItem>
        <TabItem Header="Текст"><TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="{DynamicResource Surface}"/></TabItem>
        <TabItem Header="HTML"><TextBox x:Name="HtmlText" IsReadOnly="True" FontFamily="Consolas" FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="{DynamicResource Surface}"/></TabItem>
        <TabItem Header="Свойства"><DataGrid x:Name="MessageProperties" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Код" Binding="{Binding DisplayId}" Width="85"/><DataGridTextColumn Header="Свойство" Binding="{Binding Description}" Width="220"/><DataGridTextColumn Header="Значение" Binding="{Binding DisplayValue}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
      </TabControl>
    </DockPanel></Border>
  </DockPanel>
</Window>
