<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../vendor/XstReader/*.cs" Link="XstReader/%(Filename)%(Extension)" />
    <Compile Include="../../src/MailArchive/ArchiveUtilities.cs" Link="ArchiveUtilities.cs" />
    <Compile Include="../../src/MailArchive/ConversionReport.cs" Link="ConversionReport.cs" />
    <Compile Include="../../src/MailArchive/MessageBodies.cs" Link="MessageBodies.cs" />
    <Compile Include="../../src/MailArchive/FolderReadPolicy.cs" Link="FolderReadPolicy.cs" />
    <Compile Include="../../src/MailArchive/MetadataCopy.cs" Link="MetadataCopy.cs" />
    <Compile Include="../../src/MailArchive/PreparedBody.cs" Link="PreparedBody.cs" />
    <Compile Include="../../src/MailArchive/MessageSelection.cs" Link="MessageSelection.cs" />
    <Compile Include="../../src/MailArchive/PreviewHtml.cs" Link="PreviewHtml.cs" />
    <Compile Include="../../src/MailArchive/OutputFileStatus.cs" Link="OutputFileStatus.cs" />
    <Compile Include="../../src/MailArchive/ExportFolderLayout.cs" Link="ExportFolderLayout.cs" />
    <Compile Include="../../src/MailArchive/PstInventory.cs" Link="PstInventory.cs" />
    <Compile Include="../../src/MailArchive/SavedMailContent.cs" Link="SavedMailContent.cs" />
    <Compile Include="../../src/MailArchive/ArchiveOutline.cs" Link="ArchiveOutline.cs" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageReference Include="AngleSharp" Version="1.8.4" />
  </ItemGroup>
</Project>
